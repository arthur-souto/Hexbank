# Copie para .env (não versionado) e ajuste. Valores abaixo são apenas para a máquina local.
# Usado pelo docker compose:
POSTGRES_DB=hexbank_db
POSTGRES_USER=hex
POSTGRES_PASSWORD=hex
POSTGRES_PORT=5433

# Usado pela aplicação (application.yaml). Exporte no shell ou configure na IDE:
SERVER_PORT=8080
DATASOURCE_URL=jdbc:postgresql://localhost:5433/hexbank_db?sslmode=disable
DATASOURCE_USERNAME=hex
DATASOURCE_PASSWORD=hex
